{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/termometros/:id", "destination": "/termometros/[id].html" },
    { "source": "/precios/:id", "destination": "/precios/[id].html" }
  ]
}
