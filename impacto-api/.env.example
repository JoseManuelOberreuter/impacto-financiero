# Copia este archivo como .env y completa tus claves. El .env no se sube a GitHub.
# Anota al lado la fecha de vencimiento de las claves que caducan.

# --- Desarrollo ---
CACHE_SEGUNDOS=0
CORS_ORIGINS=http://localhost:8081

# --- Prioridad 1 ---
# Banco Central (BDE): API Key Token de "Mi Cuenta" en si3.bcentral.cl/siete. Vence al año (se puede extender).
# Vence: 
BCCH_TOKEN=
# CMF: apikey recibida por correo.
CMF_API_KEY=

# --- Prioridad 2 ---
# CNE (bencina y gas): correo y clave de la cuenta en api.cne.cl. La API pide un token nuevo con ellos.
CNE_EMAIL=
CNE_PASSWORD=
# Anthropic (clasificar noticias).
ANTHROPIC_API_KEY=

# --- Prioridad 3 y 4 (opcionales) ---
COORDINADOR_USUARIO=
COORDINADOR_CLAVE=
FRED_API_KEY=
EIA_API_KEY=
MERCADO_PUBLICO_TICKET=

# --- Base de datos ---
SUPABASE_URL=
# Clave pública (anon): la puede usar la app para iniciar sesión.
SUPABASE_ANON_KEY=
# Clave service_role: solo en el backend, nunca en la app.
SUPABASE_SERVICE_ROLE_KEY=
